<div class="cyberpunk cyberpunk-card cp-attack-card flexcol">
    <h2>{{CPLocal "SuppressiveFire"}}</h2>
    <p class="cp-weapon">{{weaponName}}</p>

    <dl class="cp-kv">
        <dt>{{CPLocal "SuppressiveRoundsLine"}}</dt><dd>{{rounds}}</dd>
        <dt>{{CPLocal "SuppressiveWidthShort"}}</dt><dd>{{width}} {{CPLocal "UnitMetres"}}</dd>
        <dt>{{CPLocal "DamagePerHit"}}</dt><dd>{{dmgFormula}}</dd>
    </dl>

    <div class="cp-bar">
        <span class="cp-bar-label">{{CPLocal "SaveShort"}}</span>
        <span class="cp-bar-total">{{saveDC}}</span>
        <span class="cp-bar-dc">· {{CPLocal "SuppressiveSaveFormula"}}</span>
    </div>
    <p class="cp-tally">{{CPLocal "SuppressiveOnFail"}}</p>

    {{#if placed}}
    {{!-- The state is the template's own only while the zone really is on the map: with no GM
          connected the render hook rewrites it, and the button below is what puts one there. --}}
    <div class="cp-section"><span>{{CPLocal "ZoneOfFire"}}</span><span class="cp-state cp-zone-state">{{CPLocal "ZoneOnMap"}}</span></div>
    <div class="cp-card-actions">
        <button type="button" class="cp-lay-zone" data-action="layZone">{{CPLocal "LayZone"}}</button>
    </div>
    {{/if}}

    {{#each results as |t idx|}}
    <div class="cp-section"><span>{{CPLocal "Target"}} {{math idx "+" 1}}</span></div>
    {{#if t.rows.length}}
    {{> "systems/cyberpunk2020/templates/chat/parts/hit-rows.hbs" rows=t.rows}}
    {{else}}
    <p class="cp-tally">{{CPLocal "NoHits"}}</p>
    {{/if}}
    {{/each}}
</div>
