<div>
    <h2>{{CPLocal 'SuppressiveFire'}} – {{weaponName}}</h2>

    <ul class="condensed">
    <li><b>{{CPLocal "SuppressiveRoundsLine"}}:</b> {{rounds}}</li>
    <li><b>{{CPLocal "SuppressiveWidthLine"}}:</b> {{width}} {{CPLocal "UnitMetres"}}</li>
    <li><b>{{CPLocal "DifficultyClassShort"}}</b> {{saveDC}}</li>
    </ul>

    <hr/>

    {{#if noRounds}}
    <p>{{CPLocal "SuppressiveNoRounds"}}</p>
    {{else}}
    <p>{{CPLocal "SuppressiveDesc" save=saveDC rounds=rounds width=width}}</p>

    <p>{{CPLocal "SuppressiveHitsDesc" dmg=dmgFormula}}</p>

    {{#if placed}}
    <p>{{CPLocal "ZonePlaced"}}</p>
    <div class="cp-card-actions">
        {{!-- Labelled by the hook, not here: it says which way the zone is about to be flipped. --}}
        <button type="button" class="cp-toggle-zone" data-action="toggleZone"></button>
    </div>
    {{/if}}
    {{/if}}

    {{#each results as |t idx|}}
    <hr/>
    <h3>{{CPLocal "Target"}} {{math idx "+" 1}}</h3>

    {{#if (gt t.hitsRoll.total 0)}}
    <div class="damage-tally">
        {{#each t.areaDamages as |damages areaName|}}
        <div>
            <label><b>{{CPLocal areaName}}</b></label>
            <ul>
            {{#each damages}}
                <li>{{CPLocal "Damage"}} {{{dmgHtml}}}</li>
            {{/each}}
            </ul>
        </div>
        {{/each}}
    </div>
    {{else}}
    <p>{{CPLocal "NoHits"}}</p>
    {{/if}}
    {{/each}}
</div>
