<div class="cyberpunk cyberpunk-card">
    <header>
        <div class="flexrow">
            {{#if img}}
            <div class="roll-image" style="background-image: url({{img}})"></div>
            {{/if}}
            <h2>{{title}}</h2>
        </div>
        <p class="flavor">{{flavor}}</p>
    </header>
    <div class="dice-tooltip flexcol">
    {{#each rolls}}
        <header class="part-header flexrow">
            {{#if name}}
                <span class="part-formula">{{name}}:</span>
            {{/if}}
            <span class="part-flavor">{{roll._formula}}</span>
            <span class="part-total {{#if isCrit}}crit {{/if}}{{#if isFumble}}fumble {{/if}}">{{roll.total}}</span>
        </header>
        <div class="dice-tooltip">
        {{#each diceInfo}}
            <section class="tooltip-part">
                <div class="dice">
                    <ol class="dice-rolls">
                    {{#each this.subrolls}}
                        <li class="roll {{this.classes}}">{{{this.result}}}</li>
                    {{/each}}
                    </ol>
                </div>
            </section>
        {{/each}}
        </div>
    {{/each}}
    </div>

    {{!-- D186 — a save card states its own result. Rendered only when the caller supplies the
          outcome, so every other roll that shares this template is untouched. --}}
    {{#if saveOutcome}}
    <div class="cp-save-outcome {{#if saveOutcome.success}}is-success{{else}}is-failure{{/if}}">
        {{#if saveOutcome.success}}
        <span class="cp-save-verdict">{{CPLocal "SaveSuccess"}}</span>
        {{else}}
        <span class="cp-save-verdict">{{CPLocal "SaveFailure"}}</span>
        {{/if}}
        <span class="cp-save-total">{{saveOutcome.total}}</span>
        <span class="cp-save-threshold">{{saveOutcome.thresholdLabel}}: {{saveOutcome.threshold}}</span>
    </div>
    {{/if}}

    {{#if fumble}}
        <hr/>
        <div class="fumble-block">
            <h3>{{fumble.title}}</h3>
            {{{fumble.html}}}
        </div>
    {{/if}}
</div>