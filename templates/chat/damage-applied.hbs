<div class="cyberpunk cyberpunk-card flexcol">
    <h2>{{CPLocal "DamageBreakdown"}}</h2>

    <div class="field-list one-col">
        <div class="field">
            <span>{{CPLocal "Target"}}: </span>
            <span class="flex-pad">{{targetName}}</span>
        </div>
    </div>

    <div class="damage-tally">
        {{#each lines as |line|}}
            <div>
                <label><b>{{CPLocal line.zone}}</b>{{#if line.headDoubled}} — {{CPLocal "DamageBreakdownHead"}}{{/if}}</label>
                <ul>
                    <li>{{CPLocalParam "DamageBreakdownLine" line}}</li>
                    {{#if line.toSdp}}
                        <li>{{CPLocalParam "DamageBreakdownSdp" line}}</li>
                    {{/if}}
                </ul>
            </div>
        {{/each}}
    </div>

    <p>{{CPLocalParam "DamageBreakdownTotal" this}}</p>

    {{#each limbs as |limb|}}
        <p>
            <b>{{CPLocal limb.zone}}</b>: {{CPLocalParam "SdpRemaining" limb}}
            {{#if limb.destroyed}} — {{CPLocal "LimbDestroyed"}}{{/if}}
            {{#if limb.useless}} — {{CPLocal "LimbUseless"}}{{/if}}
        </p>
    {{/each}}

    {{#if shock}}
        <p><b>{{#if shock.stacked}}{{CPLocalParam "ShockSaveLine" shock}}{{else}}{{CPLocalParam "ShockSaveNoCombat" shock}}{{/if}}</b></p>
    {{/if}}

    {{#each severedLimbs as |limb|}}
        <p><b>{{CPLocalParam "SeveranceLimb" limb}}</b></p>
    {{/each}}

    {{#if killed}}
        <p><b>{{CPLocal "SeveranceDeath"}}</b></p>
    {{/if}}
</div>
