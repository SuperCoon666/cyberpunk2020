<div class="cyberpunk cyberpunk-card flexcol">
    <h2>{{title}}</h2>

    <div class="field-list one-col">
        <div class="field">
            <span>{{CPLocal "Weapon"}}: </span>
            <span class="flex-pad">{{weaponName}}</span>
        </div>

        {{#if target}}
        <div class="field">
            <span>{{CPLocal "Target"}}: </span>
            <span class="flex-pad">{{target.name}}</span>
        </div>
        {{/if}}

        {{#if range}}
        <div class="field">
            <span>{{CPLocal "Range"}}: </span>
            <span class="flex-pad">{{CPLocalParam range locals.range}}</span>
        </div>
        {{/if}}

        {{#if toHit}}
        <div class="field">
            <span>{{CPLocal "ToHit"}}: </span>
            <span class="flex-pad">{{toHit}}</span>
        </div>
        {{/if}}
    </div>

    {{!-- A charge blown off the deployed list was rolled for when it was set, not now, so the
          detonation card has no attack roll and no on-target line. --}}
    {{#if attackRoll}}
    <div class="field-list one-col">
        <div class="field" style="grid-column-end: span 1">
            <span>{{CPLocal "Attack"}}: </span>
            <span>{{attackRoll._total}}</span>
            <span class="flex-pad"></span>
            <span class="roll-results">
                {{#each attackRoll.terms as |term|}}
                    {{#if term.results}}
                        {{#each term.results as |die|}}
                            <span class="roll-result roll die d{{term.faces}}">{{die.result}}</span>
                        {{/each}}
                    {{else}}
                        <span class="roll-result inactive">{{compare term.operator "||" term.number}}</span>
                    {{/if}}
                {{/each}}
            </span>
        </div>
    </div>

    {{!-- Only the miss says anything (D251): a shot that landed where it was aimed is what the
          attack total and the drawing already show, and a sentence saying so again is noise.
          A miss with no canvas scatters nothing, so it has no sentence either: the manual-fallback
          paragraph below is what that card says. It used to print the grenade's own line with its
          {distance} unsubstituted, because `format` leaves the braces when handed no data
          (`client/helpers/localization.mjs:444`, 14.365.0). --}}
    {{#if scatterCaption}}
    <p><em>{{scatterCaption}}</em></p>
    {{/if}}
    {{/if}}

    <h3>{{CPLocal "Damage"}}</h3>
    <div class="field-list one-col">
        <div class="field">
            <span>{{CPLocal "Damage"}}: </span>
            <span class="flex-pad">{{{damageHtml}}}</span>
        </div>
        {{#if isCorridor}}
        {{!-- A shotgun pattern (or a flamethrower sweep) is a width, not a radius, and it takes
              the line of fire with it. --}}
        <div class="field">
            <span>{{corridorWidthLabel}}: </span>
            <span class="flex-pad">{{spreadWidth}} {{CPLocal "UnitMetres"}}</span>
        </div>
        {{else}}
        <div class="field">
            <span>{{CPLocal "BlastRadius"}}: </span>
            <span class="flex-pad">{{radius}} {{CPLocal "UnitMetres"}}</span>
        </div>
        {{!-- Only when it says something the radius has not: with no falloff the full-damage
              radius *is* the radius, and printing it twice reads as two different numbers. --}}
        {{#unless (eq fullDamageWithin radius)}}
        <div class="field">
            <span>{{CPLocal "BlastFullDamage"}}: </span>
            <span class="flex-pad">{{fullDamageWithin}} {{CPLocal "UnitMetres"}}</span>
        </div>
        {{/unless}}
        {{/if}}
    </div>

    {{#if isCorridor}}
    <p><em>{{corridorCaption}}</em></p>
    {{/if}}

    {{!-- D241 — the round ran out before the target did. Only a pattern carries this. --}}
    {{#if fellShort}}
    <p><em>{{fellShort}}</em></p>
    {{/if}}

    {{!-- D192's ring, said rather than enforced (D54): only a chained autoshotgun pattern past the
          first one carries this, so the line is absent from every other card. --}}
    {{#if adjacency}}
    <p><em>{{adjacency}}</em></p>
    {{/if}}

    {{!-- D243/D247 — who the shot caught, where each one takes it and how much, so a splash reads
          as an attack and not only as a shape. Grouped as `multi-hit.hbs` groups a burst, one level
          deeper: target, then location, then the shares. Written when the shot went off; tokens the
          players cannot see are left off it (D31/D120) and take their share whispered. --}}
    {{#if caught}}
    <div class="damage-tally zone-targets">
        <label><b>{{CPLocal "ZoneTargets"}}</b></label>
        {{#each caught as |entry|}}
            <div class="zone-target">
                <label><b>{{entry.name}}</b></label>
                {{#each entry.areaDamages as |damages areaName|}}
                    <div class="zone-target-area">
                        <label>{{CPLocal areaName}}</label>
                        <ul>
                            {{#each damages as |share|}}
                                <li>{{CPLocal "Damage"}} {{{share.damageHtml}}}</li>
                            {{/each}}
                        </ul>
                    </div>
                {{/each}}
            </div>
        {{/each}}
    </div>
    {{/if}}

    {{#if rings}}
    <div class="damage-tally">
        <label><b>{{CPLocal "BlastFalloff"}}</b></label>
        <ul>
            {{#each rings as |ring|}}
                <li>{{CPLocalParam "BlastRingBand" ring}}</li>
            {{/each}}
        </ul>
    </div>
    {{/if}}

    {{#if placed}}
    <div class="cp-card-actions">
        <button type="button" class="cp-apply-zone" data-action="applyZone">
            {{CPLocal "ApplyDamage"}}
        </button>
        {{!-- Decided per client by the hook, which removes it when it does not apply: the drawing is
              laid by the active GM, and with none connected it waits here for one (`T305`). --}}
        <button type="button" class="cp-draw-zone" data-action="drawZone">{{CPLocal "DrawZone"}}</button>
    </div>
    {{else}}
    <p><em>{{CPLocal "BlastManual"}}</em></p>
    {{/if}}

    {{#if fumble}}
        <hr/>
        <div class="fumble-block">
            <h3>{{fumble.title}}</h3>
            {{{fumble.html}}}
        </div>
    {{/if}}
</div>
