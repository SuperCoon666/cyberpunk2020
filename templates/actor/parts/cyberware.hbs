<div class="field-list no-wrap">
    <div class="field">
        <label>{{CPLocal "TotalEBVal"}}</label>
        <input type="number" value="{{gear.cyberCost}}" readonly>
    </div>
    <div class="field">
        <label for="system.stats.emp.humanity.loss">{{CPLocal "HumanityLoss"}}</label>
        <input type="number" value="{{system.stats.emp.humanity.loss}}" readonly>
    </div>
</div>

<header class="cyberware-header">
    <h2>{{CPLocal "ActiveChipware"}}</h2>
</header>
<div class="chip-scroll-wrapper">
  <div class="chipware-container {{#unless chipsActive.length}}is-empty{{/unless}}" data-drop-target="active-chips">
    {{#if chipsActive.length}}
      {{#each chipsActive as |chip|}}
        {{#with chip.system}}
          <div class="chipware field gear full-width"
               data-full="{{chip.name}}"
               style="background-image: url('systems/cyberpunk2020/img/chip.png')"
               data-item-id="{{chip.id}}"
               draggable="true">
            <span class="chip-name">
              <span class="chip-name-text">{{chip.name}}</span>
            </span>
            <div class="chipware-slot item-unequip" data-item-id="{{chip.id}}" draggable="false">X</div>
          </div>
        {{/with}}
      {{/each}}
    {{else}}
      <div class="chipware-dropzone" data-drop-target="active-chips"></div>
    {{/if}}
  </div>
</div>
<header class="cyberware-header">
    <h2>{{CPLocal "ActiveCyberware"}}</h2>
</header>


{{!-- One body for both zone columns. They were hand-duplicated, and a change made to one of the
      two copies shipped half-applied — the activation toggle reached the right column only. --}}
{{#*inline "cyberZoneColumn"}}
    {{#each segments}}
        <section class="field-list cyberware-field-list active-cyberware-segment"
                 data-drop-target="zone:{{this.area}}">
            <button type="button">{{this.areaLabel}}</button>
            {{#each (lookup ../zones this.area) as |cyber|}}
                <div class="field gear item-edit full-width item" data-item-id="{{cyber.id}}" draggable="true">
                    <label title="{{cyber.name}}">{{cyber.name}}</label>
                    <span class="flex-pad"></span>
                    {{#with cyber.system}}
                        {{#if (equals EffectMode "Activatable")}}
                            <span class="cyber-effect-toggle" title="{{CPLocal 'CWT_EffectActive'}}">
                                <input type="checkbox" class="cyber-effect-active"
                                       data-item-id="{{cyber.id}}" {{checked EffectActive}}/>
                            </span>
                        {{/if}}
                        <span>{{CPLocal "HumanityLossAbbrev"}}: {{humanityLoss}}</span>
                    {{/with}}
                    <span class="item-unequip" data-item-id="{{cyber.id}}" draggable="false">X</span>
                </div>
            {{/each}}
        </section>
    {{/each}}
{{/inline}}

<div class="active-cyberware" style="background-image: url('systems/cyberpunk2020/img/grid-beige-big-tile.png')">
    <div class="active-cyberware-right" >
        {{> cyberZoneColumn segments=cyberwareSegmentsRight zones=cyberZones}}
    </div>

    <div class="anatomy-container" style="background-image: url('systems/cyberpunk2020/img/black_gray_grid.png');">
        <img
            src="systems/cyberpunk2020/img/male-anatomy-unsegmented.svg"
            id="anatomy-img"
            alt="{{CPLocal 'CyberwareAnatomyAlt'}}"
            draggable="false"
        />
    </div>
    <div class="active-cyberware-left">
        {{> cyberZoneColumn segments=cyberwareSegmentsLeft zones=cyberZones}}
    </div>
</div>

<div class="cyberware-header">
    <header>
        <h2>{{CPLocal "Cyberware"}}</h2>
    </header>
</div>
{{#if (equals items.length 0)}}
<div class="inactive">{{CPLocal "DragItemsPrompt"}}</div>
{{/if}}
<div class="field-list" data-drop-target="cyber-inventory">
    {{#each gear.cyberware as |cyber|}}
    <div class="field gear item-edit full-width item" data-item-id="{{cyber.id}}" draggable="true">
        <div class="field-image" data-item-id="{{cyber.id}}">
            <img src={{cyber.img}}>
        </div>
        <label class="cyber-name" title="{{cyber.name}}">{{cyber.name}}</label>
        <span class="flex-pad"></span>
            {{#with cyber.system}}
                <span class="cyber-hm-loss">{{CPLocal "HumanityLossAbbrev"}}: {{humanityLoss}}</span>
            {{/with}}
        <span class="item-delete" data-item-id="{{cyber.id}}">X</span>
    </div>
    {{/each}}
</div>