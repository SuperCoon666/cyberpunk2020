<div class="armor-display">
  {{#each hitLocations as |hitLoc name|}}
    <div class="field armor-segment" style="grid-area: {{name}}">

      {{#if hitLoc.location}}
        <label class="segment-loc" title="{{CPLocal "HitLoc"}}">
          <p class="inactive">{{displayRange hitLoc.location}}</p>
        </label>
      {{/if}}

      {{!-- Ablation belongs to one armor item, so the buttons live on the editable path only: on the
            actor sheet the zone's SP is layered from several items and there is no single owner. --}}
      {{#if ../edit}}
        <span class="segment-ablate action" title="{{CPLocalParam "AblationCurrent" hitLoc}}" data-hit-loc="{{name}}">-</span>
        <span class="segment-repair action" title="{{CPLocalParam "AblationCurrent" hitLoc}}" data-hit-loc="{{name}}">+</span>
      {{/if}}

      {{!-- The name is emitted only on the editable path: this partial is shared with the armor
            item sheet, where this input is the real control, while on the actor sheet the same
            field is derived and submitOnChange would persist it over prepareData's own value. --}}
      <input
        type="number"
        class="segment-sp {{#unless ../edit}}not-editable{{/unless}}"
        title="{{CPLocal "SPFull"}}"
        {{#if ../edit}}name="system.{{../hitLocsName}}.{{name}}.stoppingPower"{{/if}}
        value="{{hitLoc.stoppingPower}}"
        {{#unless ../edit}}readonly{{/unless}}>

        {{!-- SDP: actors only (system.sdp.sum exists). The sum alone decides: it is the zone's
              maximum, so a zone with no implant has no SDP to show. `current` is the player's own
              note of what is left and never gates the row — editing it to 0 used to hide the pair
              and leave no way back. An orphaned `current` is not stranded by this: the
              reconciliation in actor.js resyncs it when the sum changes, including to 0. --}}
        {{#if ../system.sdp.sum}}
          {{#unless (or (equals (lookup ../system.sdp.sum name) 0) (equals (lookup ../system.sdp.sum name) "0"))}}
            <div class="segment-sdp-row">
              <input
                type="number"
                class="smallnumber"
                title="{{CPLocal "SDPSumTooltip"}}"
                value="{{lookup ../system.sdp.sum name}}"
                readonly>
              <input
                type="number"
                class="smallnumber"
                title="{{CPLocal "SDPCurrentTooltip"}}"
                name="system.sdp.current.{{name}}"
                value="{{lookup ../system.sdp.current name}}">
            </div>
          {{/unless}}
        {{/if}}

      <label class="segment-name">{{shortCPLocal name}}</label>
    </div>
  {{/each}}
</div>
