{{!-- Actor sheet's combat tab --}}
<div class="combat-tab">
    <section class="combat-rolls">
        {{!-- `data-sync` is what keeps the section folded across a re-render: core reads
              `details[data-sync]` before it replaces a part and restores the flag after
              (client/applications/api/handlebars-application.mjs:256 and :279, 14.365.0).
              Without the attribute, editing a modifier below would spring the section open. --}}
        <details class="section-fold" data-sync="combat-actions" open>
            <summary>
                <h2>{{CPLocal "CombatActions"}}</h2>
            </summary>
        </details>

        {{!-- The lists are the fold's sibling, not its content: Chrome paints an open
              `<details>`'s own content through `::details-content` and skips it for the first
              frames of a render, which showed as an Actions section that filled in a beat after
              the rest of the tab. Measured. --}}
        <div class="fold-body">

            <div class="field-list combat-saves">
                <div class="field roll-initiative">
                    <label class="action">{{CPLocal "Initiative"}}</label>
                    <span class="flex-pad"></span>
                    <input class="roll-initiative-modificator number" type="number" {{#unless (eq initiativeMod 0)}}value="{{initiativeMod}}"{{/unless}} placeholder="0">
                </div>

                <div class="field stun-death-save">
                    <label class="action">{{CPLocal "StunDeathSave"}}</label>
                    <span class="flex-pad"></span>
                    <input class="roll-stun-death-modificator number" type="number" data-tooltip="{{CPLocal 'StunDeathBonusHint'}}" {{#unless (eq stunDeathSaveBonus 0)}}value="{{stunDeathSaveBonus}}"{{/unless}} placeholder="0">
                </div>
            </div>

            {{!-- The two fixed actions every character has, whatever they are carrying: the unarmed
                  attack that replaced the injected Strike/Kick items, and the stabilization roll. --}}
            <div class="field-list combat-actions">
                {{#if unarmed}}
                <div class="field action unarmed-attack" data-tooltip="{{CPLocal 'UnarmedAttackHint'}}">
                    <div class="no-action field-image" style="background-image: url({{unarmed.img}})"></div>
                    <label class="name">{{CPLocal "UnarmedAttack"}}</label>
                    <span class="flex-pad"></span>
                </div>
                {{/if}}

                <div class="field action stabilize-roll" data-tooltip="{{CPLocal 'StabilizeHint'}}">
                    <div class="no-action field-image" style="background-image: url(systems/cyberpunk2020/img/pulse-icon.svg)"></div>
                    <label class="name">{{CPLocal "Stabilization"}}</label>
                    <span class="flex-pad"></span>
                </div>
            </div>

            {{!-- Moved off the wound tracker (T222): the flag the stabilization roll sets belongs
                  beside the button that sets it, not beside the boxes a GM clicks. --}}
            <div class="field-list combat-state">
                {{> (template "fields/boolean") label="Stabilized" edit="system.stabilized"}}
            </div>
        </div>
    </section>

    {{!-- Armour is placed in the right-hand column by the grid, so it follows the two sections it
          sits beside in reading order — which is also the order the tab collapses to when the
          sheet is too narrow for two columns. --}}
    <section class="weapons-list">
        <header>
            <h2>{{CPLocal "Weapons"}}</h2>
        </header>

        {{!-- Normal weapons --}}
        {{#each gear.weapons as |weapon|}}
            <div class="fire-weapon field action" data-item-id="{{weapon.id}}">
            {{!-- D106 — the icon is its own action (it opens the item), so it is not `.no-action`. --}}
            <div class="field-image item-edit" style="background-image: url({{weapon.img}})" data-item-id="{{weapon.id}}"></div>
            <label class="name" title="{{weapon.name}}">{{weapon.name}}</label>
            <span class="flex-pad"></span>
            <span>
                {{#with weapon.system}}
                <div class="field-label inactive">{{#if attackType}}{{CPLocal attackType}}{{else}}{{CPLocal weaponType}}{{/if}}</div>
                {{/with}}
            </span>
            </div>
        {{/each}}

        {{!-- Cyberweapons --}}
        {{#each gear.cyberware as |cyber|}}
            {{#if (and (cwHasType cyber.system.CyberWorkType "Weapon") (cwIsEnabled cyber))}}
                <div class="fire-weapon field action" data-item-id="{{cyber.id}}">
                <div class="field-image item-edit" style="background-image: url({{cyber.img}})" data-item-id="{{cyber.id}}"></div>
                <label class="name" title="{{cyber.name}}">{{cyber.name}}</label>
                <span class="flex-pad"></span>
                <span>
                {{#with cyber.system.CyberWorkType.Weapon}}
                <div class="field-label inactive">{{#if attackType}}{{CPLocal attackType}}{{else}}{{CPLocal weaponType}}{{/if}}</div>
                {{/with}}
                </span>
            </div>
            {{/if}}
        {{/each}}

        {{!-- Charges this character has set down and not yet blown (D83). The header is the
              section's own device reused, so the list reads as part of the weapons column; it is
              rendered only when there is something on it. --}}
        {{#if system.deployedCharges.length}}
        <header>
            <h2>{{CPLocal "DeployedCharges"}}</h2>
        </header>
        {{#each system.deployedCharges as |charge|}}
            <div class="detonate-charge field action" data-charge-id="{{charge.id}}" data-tooltip="{{CPLocal 'DetonateHint'}}">
            <div class="no-action field-image" style="background-image: url({{charge.img}})"></div>
            <label class="name" title="{{charge.name}}">{{charge.name}}</label>
            <span class="flex-pad"></span>
            <span>
                <div class="field-label inactive">{{CPLocal "Detonate"}}</div>
            </span>
            <i class="fas fa-trash charge-remove" data-charge-id="{{charge.id}}" data-tooltip="{{CPLocal 'ChargeRemoveHint'}}"></i>
            </div>
        {{/each}}
        {{/if}}
    </section>

    <section class="armor-section">
        <header>
            <h2>{{CPLocal "Armor"}}</h2>
            {{#if armorWear.showRepairAll}}
                <button type="button" class="armor-repair-all">{{CPLocal "ArmorRepairAll"}}</button>
            {{/if}}
        </header>

        {{> (template "actor/parts/armor-display") hitLocations=system.hitLocations hitLocsName="hitLocations"}}
        <div class="field margin-bottom">
            <label for="system.stats.ref.armorMod">{{CPLocal "Encumbrance"}}</label>
            <span class="flex-pad"></span>
            <input type="number" value="{{system.stats.ref.armorMod}}" class="number nogrow" readonly>
        </div>

        <div class="field-list one-col">
            {{#each gear.armor}}
            {{#if system.equipped}}
            <div class="field armor-item item-edit" data-item-id="{{id}}">
                <div class="field-image" style="background-image: url({{img}})" data-item-id="{{id}}"></div>
                <label class="name" title="{{name}}">{{name}}</label>
                {{#with (lookup @root.armorWear.items id) as |wearItem|}}
                    <span class="armor-wear-chip" title="{{CPLocalParam "AblationCurrent" wearItem}}">{{CPLocalParam "ArmorWearShort" wearItem}}</span>
                    {{!-- ../id: inside the #with block the context is wearItem, and a bare {{id}}
                          rendered the attribute empty, so the wrench repaired nothing. --}}
                    <i class="fas fa-wrench armor-repair-item action" data-item-id="{{../id}}" data-tooltip="{{CPLocal 'ArmorRepair'}}"></i>
                {{/with}}
                {{#with (armorSummary system.coverage) as |zones|}}
                    <label class="armor-zones" title="{{zones}}">{{zones}}</label>
                {{/with}}
            </div>
            {{/if}}
            {{/each}}

            {{!-- Cyber-armor rows: the same gate as the SP layering in actor.js (equipped, enabled,
                  Armor type), so the list shows exactly what the rules are counting. --}}
            {{#each gear.cyberware as |cyber|}}
                {{#if (and (cwHasType cyber.system.CyberWorkType "Armor") (cwIsEnabled cyber) cyber.system.equipped)}}
                <div class="field armor-item item-edit" data-item-id="{{cyber.id}}">
                    <div class="field-image" style="background-image: url({{cyber.img}})" data-item-id="{{cyber.id}}"></div>
                    <label class="name" title="{{cyber.name}}">{{cyber.name}}</label>
                    {{#with (lookup @root.armorWear.items cyber.id) as |wearItem|}}
                        <span class="armor-wear-chip" title="{{CPLocalParam "AblationCurrent" wearItem}}">{{CPLocalParam "ArmorWearShort" wearItem}}</span>
                        <i class="fas fa-wrench armor-repair-item action" data-item-id="{{cyber.id}}" data-tooltip="{{CPLocal 'ArmorRepair'}}"></i>
                    {{/with}}
                    {{#with (armorSummary cyber.system.CyberWorkType.Locations) as |zones|}}
                        <label class="armor-zones" title="{{zones}}">{{zones}}</label>
                    {{/with}}
                </div>
                {{/if}}
            {{/each}}
        </div>
    </section>
</div>
