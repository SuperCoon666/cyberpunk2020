<div class="field{{#if extraClasses}} {{extraClasses}}{{/if}}" data-path="{{edit}}"{{#if tooltip}} data-tooltip="{{CPLocal tooltip}}"{{/if}}>
    <label for="{{edit}}">{{CPLocal label}}</label>
    <span class="flex-pad"></span>

    <input
        {{#if readOnly}}readonly{{/if}}
        class="number nogrow nowidth"
        name="{{edit}}"
        type="number"
        data-min="{{min}}"
        data-max="{{max}}"
        {{#if step}}step="{{step}}"{{/if}}

        {{!-- D198 — a stored 0 shows as an empty cell with the grey `0` placeholder, which is the
              rendering the sheet is meant to have. The data-loss half of `T355` is held on the
              submit side instead: an empty number input submits its key carrying `null`
              (`FormDataExtended#_getFieldValue`, `client/applications/ux/form-data-extended.mjs:200`,
              14.365.0), and a non-nullable `NumberField` cleans that to its `initial` — the refill
              `T355` measured. `zeroEmptyNumberFields` puts the 0 back before the update, so
              emptying a box stores 0 rather than the schema default (`T375`).

              A readOnly box keeps rendering its value, zero included: it is not a box anyone can
              empty, and D198 leaves that rendering where it is. --}}
        {{#if readOnly}}
            value="{{deepLookup . edit}}"
        {{else}}
            {{#unless (eq (deepLookup . edit) 0)}}value="{{deepLookup . edit}}"{{/unless}}
            placeholder="0"
        {{/if}}
    />
</div>
