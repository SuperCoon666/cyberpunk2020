<div class="field{{#if extraClasses}} {{extraClasses}}{{/if}}" data-path="{{edit}}">
    <label for="{{edit}}">{{CPLocal label}}</label>
    <span class="flex-pad"></span>

    <input
        {{#if readOnly}}readonly{{/if}}
        class="number nogrow nowidth"
        name="{{edit}}"
        type="number"
        data-min="{{min}}"
        data-max="{{max}}"
        {{#if step}}step="{{step}}"{{/if}}

        {{!-- A zero must render as `value="0"`, never as an empty box: an empty number input
              submits no key at all, so `submitOnChange` drops the field and the DataModel refills
              it with its initial — a spent magazine silently reloading itself (`T355`). --}}
        value="{{deepLookup . edit}}"
        {{#unless readOnly}}placeholder="0"{{/unless}}
    />
</div>