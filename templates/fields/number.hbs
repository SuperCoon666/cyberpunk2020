<div class="field{{#if extraClasses}} {{extraClasses}}{{/if}}" data-path="{{edit}}">
    <label for="{{edit}}">{{CPLocal label}}</label>
    <span class="flex-pad"></span>

    <input
        {{#if readOnly}}readonly{{/if}}
        class="number nogrow nowidth"
        name="{{edit}}"
        type="number"
        data-min="{{min}}"
        data-max="{{max}}"
        {{#if step}}step="{{step}}"{{/if}}

        {{#if readOnly}}
            value="{{deepLookup . edit}}"

        {{else}}
            {{#unless (eq (deepLookup . edit) 0)}}
                value="{{deepLookup . edit}}"
            {{/unless}}
            placeholder="0"
        {{/if}}
    />
</div>