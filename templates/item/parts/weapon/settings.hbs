{{!-- Stuff that affects a single given attack's effects at the other end --}}
<div class="field-list">
    {{> (template "fields/string") label="Damage" edit="system.damage"}}
    {{> (template "fields/number") label="Accuracy" edit="system.accuracy"}}
    {{#if isThrown}}
        {{!-- D37/D52 — a throw reaches 10m × BOD of the thrower, so the item's own number is not
              read at all for a thrown weapon and showing it editable would be a lie. --}}
        <div class="field" data-tooltip="{{CPLocal 'ThrownRangeHint'}}">
            <label>{{CPLocal "Range"}}</label>
            <div class="flex-pad"></div>
            {{#if thrownRange}}
                <span>{{CPLocalParam "ThrownRangeValue" thrownRange}}</span>
            {{else}}
                <span>{{CPLocal "ThrownRangeNoThrower"}}</span>
            {{/if}}
        </div>
    {{else}}
        {{> (template "fields/number") label="Range" edit="system.range"}}
    {{/if}}

    {{> (template "fields/select") label="Reliability" edit="system.reliability" choices=reliabilities}}
</div>

{{!-- Ammo-related fields: only for ranged weapons --}}
{{#unless (equals system.weaponType 'Melee')}}
<div class="field-list">
    {{> (template "fields/number") label="ShotsLeft" edit="system.shotsLeft"}}
    {{> (template "fields/number") label="Shots" edit="system.shots"}}
    {{> (template "fields/number") label="RoF" edit="system.rof"}}
    {{> (template "fields/select") label="Ammo" edit="system.ammoItemId" choices=ammoChoices allowBlank=true}}
</div>
{{/unless}}

{{!-- What kind of thing is this weapon, how it's used --}}
<div class="field-list">
    {{!-- When changing weapon type, the weapon's attack type will not update correspondingly until the sheet is closed --}}
    {{> (template "fields/select") label="WeaponType" edit="system.weaponType" choices=weaponTypes}}
    {{> (template "fields/select") label="AttackType" edit="system.attackType" choices=attackTypes allowBlank=true}}
    {{!-- Custom, as all the translate keys start with Skill, but they don't in the character --}}
    {{!-- This might not need to be custom anymore, as regular selects can deal with choices that supply their own translateKeys --}}
    <div class="field">
        <label for="system.attackSkill">{{CPLocal "AttackSkill"}}</label>
        <div class="flex-pad"></div>
        {{#if (equals system.weaponType 'Exotic')}}
            {{!-- This will be populated by actor skills if it's held by an actor, but an input is at least editable --}}
            <datalist id="possibleSkills">
                {{#each attackSkills as |skill|}}
                <option value="{{skill.value}}">{{skill.label}}</option>
                {{/each}}
            </datalist>
            <input type="text" list="possibleSkills" placeholder="Choose Skill" name="system.attackSkill" value="{{system.attackSkill}}"/>
        {{else}}
            <select name="system.attackSkill">
                {{#each attackSkills as |skill|}}
                <option value="{{skill.value}}" {{#if (equals ../system.attackSkill skill.value)}}selected{{/if}}{{#if (equals ../system.attackSkill skill.label)}}selected{{/if}}>{{skill.label}}</option>
                {{/each}}
            </select>
        {{/if}}
    </div>
    {{> (template "fields/select") label="Concealability" edit="system.concealability" choices=concealabilities}}
</div>

{{!-- Market stuff --}}
<div class="field-list">
    {{> (template "fields/select") label="Availability" edit="system.availability" choices=availabilities}}

    {{#if isMelee}}
        {{> (template "fields/boolean") label="AP" edit="system.ap"}}
        {{!-- A mono edge is a kind of edge, so it only means anything on a weapon that has one. --}}
        {{#if system.ap}}
            {{> (template "fields/boolean") label="WeaponMono" edit="system.mono"}}
        {{/if}}
    {{else}}
        {{!-- `T340` — the box reads the way the reload families read everywhere else: `CPLocal`
              translates a known key and echoes anything else, so a value already written as prose
              renders unchanged. It carries **no `name`** on purpose. `submitOnChange` writes every
              named input on this sheet whenever any one of them changes (measured: editing `cost`
              posts `system.ammoType` with it), which would persist the *localized* text over the
              key the next time something unrelated here was edited — and the localization would
              then be gone from that document, per world and per language. Its own change handler
              is the only writer. --}}
        <div class="field">
            <label>{{CPLocal "AmmoType"}}</label>
            <span class="flex-pad"></span>
            <input class="textsize weapon-ammo-type" type="text" value="{{CPLocal system.ammoType}}"/>
        </div>
    {{/if}}
</div>
