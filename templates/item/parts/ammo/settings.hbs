<div class="field-list">
    <div class="field span-two-cells">
        <label class="larger">{{CPLocal "AmmoEffects"}}</label>
        <span class="flex-pad"></span>
    </div>

    <div class="field ammo-ms-field">
        <label>{{CPLocal "AmmoEffectTypes"}}</label>
        <span class="flex-pad"></span>

        {{!-- Dropdown-multiselect (ammo-specific, duplicated styling from cyberware) --}}
        <div class="ammo-ms" data-path="system.effectTypes">
            <button type="button" class="ammo-ms-trigger">
                <span class="ammo-ms-labels">
                    {{#if ammoFx.typeLabels.length}}
                        {{#each ammoFx.typeLabels}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}
                    {{else}}
                        {{CPLocal "AmmoEffect_Standard"}}
                    {{/if}}
                </span>
                <i class="fa-solid fa-caret-down ammo-ms-caret"></i>
            </button>

            <div class="ammo-ms-menu">
                <label class="ammo-ms-opt">
                    <input type="checkbox" value="Standard" {{#if (ammoHasEffect system "Standard")}}checked{{/if}}>
                    {{CPLocal "AmmoEffect_Standard"}}
                </label>

                <label class="ammo-ms-opt">
                    <input type="checkbox" value="AP" {{#if (ammoHasEffect system "AP")}}checked{{/if}}>
                    {{CPLocal "AmmoEffect_AP"}}
                </label>

                <label class="ammo-ms-opt">
                    <input type="checkbox" value="Slug" {{#if (ammoHasEffect system "Slug")}}checked{{/if}}>
                    {{CPLocal "AmmoEffect_Slug"}}
                </label>

                <label class="ammo-ms-opt">
                    <input type="checkbox" value="Mono" {{#if (ammoHasEffect system "Mono")}}checked{{/if}}>
                    {{CPLocal "AmmoEffect_Mono"}}
                </label>

                <label class="ammo-ms-opt">
                    <input type="checkbox" value="Electroshock" {{#if (ammoHasEffect system "Electroshock")}}checked{{/if}}>
                    {{CPLocal "AmmoEffect_Electroshock"}}
                </label>

                <label class="ammo-ms-opt">
                    <input type="checkbox" value="Incendiary" {{#if (ammoHasEffect system "Incendiary")}}checked{{/if}}>
                    {{CPLocal "AmmoEffect_Incendiary"}}
                </label>

                <label class="ammo-ms-opt">
                    <input type="checkbox" value="Buckshot" {{#if (ammoHasEffect system "Buckshot")}}checked{{/if}}>
                    {{CPLocal "AmmoEffect_Buckshot"}}
                </label>

                <label class="ammo-ms-opt">
                    <input type="checkbox" value="Blast" {{#if (ammoHasEffect system "Blast")}}checked{{/if}}>
                    {{CPLocal "AmmoEffect_Blast"}}
                </label>

                <label class="ammo-ms-opt">
                    <input type="checkbox" value="DamageReplace" {{#if (ammoHasEffect system "DamageReplace")}}checked{{/if}}>
                    {{CPLocal "AmmoEffect_DamageReplace"}}
                </label>
            </div>
        </div>
    </div>

    {{> (template "fields/select")
        label="WeaponType"
        edit="system.weaponType"
        choices=ammoReloadTypes
        allowBlank=true
    }}

    {{!-- Boxes and loose are not stored: the total is, and these two are it divided by the box
          size — full boxes, and the one that has been opened. Editing either recomputes the
          total. The grid is row-major, so this order reads boxes / per box over total / loose. --}}
    <div class="field">
        <label>{{CPLocal "AmmoBoxes"}}</label>
        <span class="flex-pad"></span>
        <input
            type="number"
            class="number nogrow nowidth ammo-pack"
            data-part="boxes"
            min="0"
            placeholder="0"
            {{#unless (eq ammoPack.boxes 0)}}value="{{ammoPack.boxes}}"{{/unless}}
            {{#unless ammoPack.perBox}}disabled{{/unless}}
        />
    </div>

    {{> (template "fields/number") label="AmmoPerBox" edit="system.perBox"}}

    {{> (template "fields/number") label="AmmoQuantity" edit="system.quantity" readOnly=true}}

    <div class="field" data-tooltip="{{CPLocal 'AmmoLooseHint'}}">
        <label>{{CPLocal "AmmoLoose"}}</label>
        <span class="flex-pad"></span>
        <input
            type="number"
            class="number nogrow nowidth ammo-pack"
            data-part="loose"
            min="0"
            placeholder="0"
            {{#unless (eq ammoPack.loose 0)}}value="{{ammoPack.loose}}"{{/unless}}
            {{#unless ammoPack.perBox}}disabled{{/unless}}
        />
    </div>

    {{!-- The round's own accuracy, damage multiplier and bonus damage are not offered: `05:629`
          gives ammunition a price and nothing else, damage belongs to the weapon's DAM column and
          accuracy to its WA, and the one round the book describes mechanically is AP — whose half
          damage and half SP are in the AP block below. The fields stay in the schema for the DLC;
          `snapshotAmmo` is what makes them contribute nothing meanwhile. --}}

    {{!-- ===== Armour piercing ===== --}}
    {{!-- D175 — the book gives AP and the slug the same two halvings (`07:458`, `07:460`,
          `07:867`), so both blocks carry both multipliers; the one rule that separates them is
          which armour exempts the penetrating damage, which is the boolean each block ends on. --}}
    {{#if (ammoHasEffect system "AP")}}
        <div class="field span-two-cells" data-tooltip="{{CPLocal 'AmmoPenHalvesHint'}}">
            <label class="larger">{{CPLocal "AmmoSectionAP"}}</label>
            <span class="flex-pad"></span>
        </div>

        {{> (template "fields/number") label="AmmoArmorMultSoft" edit="system.armorMultSoft"}}
        {{> (template "fields/number") label="AmmoArmorMultHard" edit="system.armorMultHard"}}

        {{> (template "fields/number") label="AmmoPenDamageMult" edit="system.penDamageMult"}}
        {{> (template "fields/boolean") label="AmmoPenHalvesSoft" edit="system.penHalvesSoft"}}
    {{/if}}

    {{!-- ===== Slug (D172) ===== --}}
    {{!-- The second carrier of armour-piercing, and exclusive with AP: `07:865-873` gives a finned
          slug "normal AP ability vs. all armors" with the hard-armour halving dropped. --}}
    {{#if (ammoHasEffect system "Slug")}}
        <div class="field span-two-cells" data-tooltip="{{CPLocal 'AmmoSlugHint'}}">
            <label class="larger">{{CPLocal "AmmoSectionSlug"}}</label>
            <span class="flex-pad"></span>
        </div>

        {{> (template "fields/number") label="AmmoArmorMultSoft" edit="system.armorMultSoft"}}
        {{> (template "fields/number") label="AmmoArmorMultHard" edit="system.armorMultHard"}}

        {{> (template "fields/number") label="AmmoPenDamageMult" edit="system.penDamageMult"}}
        {{> (template "fields/boolean") label="AmmoPenHalvesHard" edit="system.penHalvesHard"}}
    {{/if}}

    {{!-- ===== Mono (D174) ===== --}}
    {{!-- The third carrier of armour-piercing, and the only one with nothing to author: `07:1065`
          states its own fractions, so the block is the rule written down rather than a form. --}}
    {{#if (ammoHasEffect system "Mono")}}
        <div class="field span-two-cells" data-tooltip="{{CPLocal 'AmmoMonoHint'}}">
            <label class="larger">{{CPLocal "AmmoSectionMono"}}</label>
            <span class="flex-pad"></span>
        </div>
    {{/if}}

    {{!-- ===== Electroshock ===== --}}
    {{#if (ammoHasEffect system "Electroshock")}}
        <div class="field span-two-cells" data-tooltip="{{CPLocal 'AmmoStunOnHitHint'}}">
            <label class="larger">{{CPLocal "AmmoSectionElectroshock"}}</label>
            <span class="flex-pad"></span>
        </div>

        {{> (template "fields/boolean") label="AmmoStunOnHit" edit="system.stunSaveOnHit"}}
        {{> (template "fields/number") label="AmmoStunPenalty" edit="system.stunSavePenalty"}}
        {{> (template "fields/boolean") label="AmmoStunIgnoresArmor" edit="system.stunIgnoresArmor"}}
    {{/if}}

    {{!-- ===== Incendiary ===== --}}
    {{#if (ammoHasEffect system "Incendiary")}}
        <div class="field span-two-cells" data-tooltip="{{CPLocal 'AmmoDoTDamageHint'}}">
            <label class="larger">{{CPLocal "AmmoSectionIncendiary"}}</label>
            <span class="flex-pad"></span>
        </div>

        {{> (template "fields/boolean") label="AmmoDoTEnabled" edit="system.dotEnabled"}}
        {{> (template "fields/number") label="AmmoDoTTurns" edit="system.dotTurns" min=0 max=10}}

        {{!-- One damage input per burning turn (D85), so the book's own declining fires can be
              written down. No `name`: the list persists through its own handler alone. --}}
        {{#each dotTickIndices}}
            <div class="field">
                <label>{{CPLocal "AmmoDoTTick"}} ({{inc this}})</label>
                <span class="flex-pad"></span>
                <input
                    type="text"
                    class="textsize ammo-dot-tick"
                    data-index="{{this}}"
                    value="{{lookup ../system.dotDamageFormulas this}}"
                />
            </div>
        {{/each}}
    {{/if}}

    {{!-- ===== Blast (AoE) ===== --}}
    {{#if (ammoHasEffect system "Blast")}}
        <div class="field span-two-cells" data-tooltip="{{CPLocal 'AmmoOverallBodyHint'}}">
            <label class="larger">{{CPLocal "AmmoSectionBlast"}}</label>
            <span class="flex-pad"></span>
        </div>

        {{!-- The falloff rings, their inner radius and the shrapnel flag are not offered: ch. 07:839
              is full damage across the whole radius, so none of them means anything to a round
              built from the book (owner, 2026-08-11). The fields, their schema and the falloff
              itself all stay for the DLC that gives them a rule — this is the display only. --}}
        {{> (template "fields/number") label="AmmoBlastRadius" edit="system.blastRadius"}}
        {{> (template "fields/boolean") label="AmmoOverallBody" edit="system.overallBody"}}
        {{> (template "fields/boolean") label="AmmoBlastThroughWalls" edit="system.blastThroughWalls"}}
    {{/if}}

    {{!-- Buckshot — the spread pattern a shell throws --}}
    {{#if (ammoHasEffect system "Buckshot")}}
        <div class="field span-two-cells">
            <label class="larger">{{CPLocal "AmmoSectionBuckshot"}}</label>
            <span class="flex-pad"></span>
        </div>
        {{> (template "fields/select")
            label="AmmoSpreadMode"
            edit="system.spreadMode"
            choices=ammoSpreadModes
            allowBlank=false
        }}
        {{#if (equals system.spreadMode "spread")}}
            {{> (template "fields/number") label="AmmoSpreadDistance" edit="system.spreadDistance"}}

            {{> (template "fields/number") label="AmmoSpreadWidthShort" edit="system.spreadWidthShort"}}
            {{> (template "fields/number") label="AmmoSpreadWidthMedium" edit="system.spreadWidthMedium"}}
            {{> (template "fields/number") label="AmmoSpreadWidthLong" edit="system.spreadWidthLong"}}
        {{/if}}
        {{> (template "fields/string") label="AmmoSpreadDamageShort" edit="system.spreadDamageShort"}}
        {{> (template "fields/string") label="AmmoSpreadDamageMedium" edit="system.spreadDamageMedium"}}
        {{> (template "fields/string") label="AmmoSpreadDamageLong" edit="system.spreadDamageLong"}}
    {{/if}}

    {{!-- Replacing damage — the round's own, in place of the weapon's (D147) --}}
    {{#if (ammoHasEffect system "DamageReplace")}}
        <div class="field span-two-cells" data-tooltip="{{CPLocal 'AmmoDamageFormulaHint'}}">
            <label class="larger">{{CPLocal "AmmoSectionDamageReplace"}}</label>
            <span class="flex-pad"></span>
        </div>

        {{> (template "fields/string") label="AmmoDamageFormula" edit="system.damageFormula"}}
    {{/if}}
</div>
